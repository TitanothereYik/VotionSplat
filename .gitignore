# Downloaded vendor archives. The extracted source is under vendor/.
_hy_fetch/

# Unreal host project build output and validation captures
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
